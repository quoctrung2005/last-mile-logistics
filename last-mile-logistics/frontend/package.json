{
  "name": "last-mile-logistics-frontend",
  "private": true,
  "scripts": {
    "start": "node dev-server.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:order-unsaved": "node tests/order-unsaved-browser.cjs",
    "test:evidence": "dotnet build ../backend/LastMile/LastMile.Api/LastMile.Api.csproj --no-restore -c Release --output tests/.artifacts/evidence/release && dotnet run --no-restore -c Release --project ../backend/LastMile/LastMile.Evidence.Tests -- tests/.artifacts/evidence/images && node tests/evidence-upload.cjs",
    "test:license-date": "dotnet run --no-restore -c Release --project ../backend/LastMile/LastMile.Calendar.Tests -- ..",
    "test:customers": "dotnet build ../backend/LastMile/LastMile.Api/LastMile.Api.csproj --no-restore --output tests/.artifacts/customers/build && node tests/customers-browser.cjs",
    "test:auth-login": "dotnet build ../backend/LastMile/LastMile.Api/LastMile.Api.csproj --no-restore --output tests/.artifacts/auth/build && node tests/auth-login.cjs",
    "test:auth-sessions": "dotnet build ../backend/LastMile/LastMile.Api/LastMile.Api.csproj --no-restore --output tests/.artifacts/auth/build && node tests/auth-sessions.cjs",
    "test:shipper-password": "dotnet build ../backend/LastMile/LastMile.Api/LastMile.Api.csproj --no-restore --output tests/.artifacts/shipper-auth/build && node tests/shipper-password-api.cjs",
    "test:shipper-profile": "dotnet build ../backend/LastMile/LastMile.Api/LastMile.Api.csproj --no-restore --output tests/.artifacts/shipper-sync/build && node tests/shipper-sync-api.cjs",
    "test:shipper-registration": "dotnet build ../backend/LastMile/LastMile.Api/LastMile.Api.csproj --no-restore --output tests/.artifacts/shipper-registration/build && node tests/shipper-registration-api.cjs",
    "test:accounts": "dotnet build ../backend/LastMile/LastMile.Api/LastMile.Api.csproj --no-restore --output tests/.artifacts/accounts/build && node tests/accounts-browser.cjs",
    "test:reports": "dotnet build ../backend/LastMile/LastMile.Api/LastMile.Api.csproj --no-restore --output tests/.artifacts/reports/build && node tests/reports-browser.cjs",
    "test:cod": "dotnet build ../backend/LastMile/LastMile.Api/LastMile.Api.csproj --no-restore --output tests/.artifacts/cod/build && node tests/cod-browser.cjs",
    "test:admin": "dotnet build ../backend/LastMile/LastMile.Api/LastMile.Api.csproj --no-restore --output tests/.artifacts/admin/build && node tests/admin-browser.cjs roles && node tests/admin-browser.cjs catalogs && node tests/admin-browser.cjs pricing && node tests/admin-browser.cjs audit && node tests/admin-browser.cjs regression",
    "test:tracking": "dotnet build ../backend/LastMile/LastMile.Api/LastMile.Api.csproj --no-restore --output tests/.artifacts/tracking/build && node tests/tracking-browser.cjs",
    "test:dispatch": "dotnet build ../backend/LastMile/LastMile.Api/LastMile.Api.csproj --no-restore --output tests/.artifacts/dispatch/build && node tests/dispatch-browser.cjs",
    "test:dashboard": "dotnet build ../backend/LastMile/LastMile.Api/LastMile.Api.csproj --no-restore --output tests/.artifacts/dashboard/build && node tests/dashboard-browser.cjs",
    "test:routing": "dotnet run --no-restore --project ../backend/LastMile/LastMile.Routing.Tests -- ../backend/LastMile/LastMile.Api/Data/roads.osm.gz ../docs/dispatch/algorithm-verification.json"
  }
}
